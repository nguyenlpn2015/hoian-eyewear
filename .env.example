# ==============================================================================
# HỘI AN EYEWEAR — CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Sao chép tệp này thành .env.local và điền các khóa cấu hình từ Supabase Dashboard:
# Project Settings -> API (URL, Anon Key, Service Role Key)

# 1. SUPABASE PUBLIC CONFIGURATION (An toàn khi dùng ở Browser / Client Components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 2. SUPABASE SERVER-ONLY SECRET (TUYỆT ĐỐI KHÔNG CÓ TIỀN TỐ NEXT_PUBLIC_)
# Khóa này có quyền bypass Row Level Security, CHỈ ĐƯỢC PHÉP DÙNG TRÊN SERVER / SCRIPTS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 3. APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

